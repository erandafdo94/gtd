# Optional — enables cross-device sync. Leave everything unset (or omit the
# file) to run the app local-first on localStorage only; it works fully without.
#
# Sync needs ONLY VITE_API_BASE_URL — email/password sign-in works on its own.
# VITE_GOOGLE_CLIENT_ID is independently optional: set it to ALSO offer the
# "Sign in with Google" button alongside email/password.

# Base URL of the FocusRouter backend (no trailing slash). Required for sync.
# Local dev: http://localhost:5080   |   Prod: your deployed API URL.
VITE_API_BASE_URL=

# Google OAuth 2.0 "Web application" Client ID, from
# https://console.cloud.google.com/apis/credentials
# Add your dev origin (e.g. http://localhost:5173) to "Authorized JavaScript origins".
# Leave blank to offer email/password sign-in only.
VITE_GOOGLE_CLIENT_ID=
