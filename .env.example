# Optional — enables Google sign-in + cross-device sync.
# Leave these unset (or omit the file) to run the app local-first on
# localStorage only. The app works fully without them.

# Google OAuth 2.0 "Web application" Client ID, from
# https://console.cloud.google.com/apis/credentials
# Add your dev origin (e.g. http://localhost:5173) to "Authorized JavaScript origins".
VITE_GOOGLE_CLIENT_ID=

# Base URL of the FocusRouter backend (no trailing slash).
# Local dev: http://localhost:5080   |   Prod: your deployed API URL.
VITE_API_BASE_URL=
